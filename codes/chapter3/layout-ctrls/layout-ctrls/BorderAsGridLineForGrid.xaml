<Window x:Class="layout_ctrls.BorderAsSplitterForGrid"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:layout_ctrls"
        mc:Ignorable="d"
        Title="BorderAsGridLineForGrid" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border  Grid.Column="1" Grid.RowSpan="3"  BorderBrush="LightGray" BorderThickness="1 0 0 0"></Border>
        <Border  Grid.Row="1" Grid.ColumnSpan="3"  BorderBrush="LightGray" BorderThickness="0 0 0 1"></Border>
    </Grid>
</Window>

    