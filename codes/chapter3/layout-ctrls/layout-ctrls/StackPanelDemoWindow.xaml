<Window x:Class="layout_ctrls.StackPanelDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:layout_ctrls"
        mc:Ignorable="d"
        Title="StackPanelDemoWindow" Height="450" Width="800">
    <StackPanel Orientation="Horizontal">
        <!--默认情况下，按钮会占用整个父元素的宽度，并且文本居中，Label和TextBlock默认文本左对齐-->
        <Label HorizontalAlignment="Center" FontSize="20" Margin="20" Width="150" Height="40">热门编程语言</Label>
        <Button Width="120" Height="40" Margin="10" Padding="10">Cpp</Button>
        <Button Width="120" Height="40" Margin="10">Java</Button>
        <Button Width="120" Height="40" Margin="10">Python</Button>
        <Button Width="120" Height="40" Margin="10">Kotlin</Button>
    </StackPanel>
</Window>
